# 习听云FM - 环境变量配置
# 复制为 .env 后修改

# JWT 密钥（生产环境务必更换为强密码）
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-me

# SQLite 数据库路径（相对于项目根目录）
SQLITE_DB_PATH=/app/backend/instance/audio_course.db

# 上传文件存储路径
UPLOAD_FOLDER=/app/backend/uploads

# 阿里云 OSS 配置（可选，不填则只使用本地存储）
OSS_ENABLED=false
OSS_ACCESS_KEY=your-oss-access-key
OSS_SECRET_KEY=your-oss-secret-key
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your-bucket-name

# AI 学习计划生成配置（OpenAI 兼容 API）
# 示例：DeepSeek
AI_API_KEY=your-api-key-here
AI_API_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 服务端口
PORT=5000
